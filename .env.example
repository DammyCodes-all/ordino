# Server-only Google AI Studio credentials.
# Never rename this to NEXT_PUBLIC_* or expose it to client components.
GOOGLE_GENERATIVE_AI_API_KEY=

# Vision-capable model used for planning, generation, and PDF review.
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash

# Gemma model used for post-PDF multilingual voice conversation.
GOOGLE_GENERATIVE_AI_VOICE_MODEL=gemma-3-27b-it
